# ==============================================================================
# Contexify Environment Configuration Template
# Copy this file to .env and configure your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Required for LLM Generation & Vector Embeddings)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Database & Vector Store Execution Mode
# ------------------------------------------------------------------------------
# Set to "local" (default) to run offline with local SQLite + local ChromaDB.
# Set to "cloud" or "turso-pinecone" to use Turso Cloud DB + Pinecone Vector Store.
DB_MODE="local"

# Optional granular overrides (leave blank to follow DB_MODE):
# VECTOR_STORE_TYPE="chromadb"   # "chromadb" or "pinecone"
# DATABASE_TYPE="sqlite"         # "sqlite" or "turso"

# ------------------------------------------------------------------------------
# 3. Turso Cloud Database (Required when DB_MODE="cloud")
# ------------------------------------------------------------------------------
TURSO_DATABASE_URL="libsql://your-database-name.aws-region.turso.io"
TURSO_AUTH_TOKEN="your_turso_jwt_auth_token_here"

# ------------------------------------------------------------------------------
# 4. Pinecone Vector Database (Required when DB_MODE="cloud")
# ------------------------------------------------------------------------------
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_INDEX_NAME="contexify"
EMBEDDING_DIMENSION=768

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 (Optional - for One-Click Google Sign-In & Sign-Up)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 6. Email Dispatch Configuration (For Email OTP Login & Password Reset)
# ------------------------------------------------------------------------------
# Option A: Brevo HTTPS API (STRONGLY RECOMMENDED for Render & Cloud Hosts)
# Bypasses Render's firewall port 587/465 blocks. No custom domain needed.
# Free tier: 300 emails/day to any user. Get free API key at: https://brevo.com
BREVO_API_KEY="xkeysib-your_brevo_api_key_here"
BREVO_FROM_EMAIL="test@gmail.com"
BREVO_FROM_NAME="test"

# Option B: Mailtrap (For local development testing in a virtual inbox)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM_EMAIL=noreply@contexify.ai
SMTP_FROM_NAME=Contexify
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Option C: Gmail SMTP Relay (For local development only - blocked on Render free tier)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD="your_16_character_app_password"
# SMTP_FROM_EMAIL=your_email@gmail.com
# SMTP_FROM_NAME=Contexify
# SMTP_USE_TLS=True
# SMTP_USE_SSL=False

# ------------------------------------------------------------------------------
# 7. RAG Chunking & Retrieval Parameters (Optional fine-tuning)
# ------------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.2

# ------------------------------------------------------------------------------
# 8. Cloudflare R2 Object Storage (Images, Documents, Media Assets)
# ------------------------------------------------------------------------------
# Storage mode: "cloudflare" (recommended) or "local" (fallback to local disk)
STORAGE_MODE="cloudflare"

# Cloudflare Account ID (found on the right sidebar of Cloudflare dashboard)
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id_here"

# Cloudflare R2 API Token (Create under R2 > Manage R2 API Tokens with Object Read & Write permission)
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"

# Name of the R2 bucket created in Cloudflare R2
CLOUDFLARE_R2_BUCKET_NAME="contexify"

# Public Access URL (e.g. from R2 Settings > Public Access > r2.dev subdomain or Custom Domain)
# Example: "https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev" or "https://media.contexify.ai"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-your_bucket_id.r2.dev"
