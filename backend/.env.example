# API Key for Google Gemini LLM & Embeddings (Optional - fallback enabled if empty)
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Email Configuration (Optional - OTP logs to terminal if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Contexify
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Google OAuth Configuration (Optional - for Google Sign-In & Sign-Up)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# --- Turso Cloud Database ---
TURSO_DATABASE_URL="paste_your_turso_database_url_here"
TURSO_AUTH_TOKEN="paste_your_turso_auth_token_here"
# --- Pinecone Vector Search ---
PINECONE_API_KEY="paste_your_pinecone_api_key_here"
PINECONE_INDEX_NAME="contexify"

# RAG Configuration Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.2
