# EAS builds only the mobile package and its shared local dependency.
# This file replaces .gitignore for EAS packaging; keep private/local exclusions here.
/*
!/.easignore
!/mobile
!/packages
/packages/*
!/packages/assistant-core

**/node_modules
**/.git
**/.expo
**/.kotlin
**/.env*
**/.npmrc
**/credentials.json
**/*.env
**/*.local
**/dist
**/web-build
**/*.tsbuildinfo
**/*.log
**/*.orig.*
**/*.jks
**/*.keystore
**/*.p8
**/*.p12
**/*.key
**/*.pem
**/*.mobileprovision
**/*.db
**/*.db-*
**/*.sqlite*
**/.DS_Store
**/Thumbs.db
/mobile/android
/mobile/ios
/mobile/modules/*/android/build
