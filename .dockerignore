# Include only inputs used by the production Dockerfile.
# Docker glob syntax is not Markdown; keep wildcard patterns literal.

**
!backend/
backend/**
!backend/requirements.txt
!backend/app/
!backend/app/**
!frontend/
frontend/**
!frontend/package.json
!frontend/.npmrc
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**

# Keep secrets and runtime artifacts out even inside included source trees.

**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.aws
**/.ssh
**/credentials.json
**/*service-account*.json
**/.git
**/node_modules
**/__pycache__
**/*.py[cod]
**/venv
**/.venv
**/data
**/chroma_db
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.log
**/*.tsbuildinfo
