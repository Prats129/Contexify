# Include only inputs used by the production Dockerfile.

**
!backend/
backend/**
!backend/requirements.txt
!backend/app/
!backend/app/**
!frontend/
frontend/**
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**

